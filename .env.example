# ---------------------------------------------------------------------------
# Frontend (Vite) — variables prefixed with VITE_ are exposed to the browser.
# Never put a Coze token in a VITE_* variable.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
# Target language being learned (the UI language is selected in the app).
VITE_TARGET_LANGUAGE=en
# Local BFF address used by the Vite dev-server proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
# Set to /linguamate-web/ when deploying to https://crystaria.github.io/linguamate-web
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# BFF (server-side only) — consumed by server/*.js and api/*.js.
# ---------------------------------------------------------------------------
COZE_API_BASE=https://api.coze.cn
COZE_TOKEN=
COZE_WORKFLOW_ANALYZE=
COZE_WORKFLOW_EXERCISE=
COZE_WORKFLOW_CHAT=
COZE_WORKFLOW_OCR=

# 1 = return deterministic fixtures without calling Coze.
# It also activates automatically when COZE_TOKEN is empty.
COZE_MOCK=1

# Optional: pass arrays/objects to Coze as JSON strings instead of native values.
# Keep 1 unless your workflow expects native arrays/objects.
COZE_STRINGIFY_PARAMS=1

# Target language used when the request does not specify one.
DEFAULT_TARGET_LANGUAGE=en

# Optional: upload OCR images to Coze Files API and pass the file id.
COZE_IMAGE_AS_FILE_ID=0
COZE_FILE_UPLOAD_URL=https://api.coze.cn/v1/files/upload

# ---------------------------------------------------------------------------
# Local BFF server
# ---------------------------------------------------------------------------
PORT=8787
